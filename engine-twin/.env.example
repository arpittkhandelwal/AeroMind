# ─── Copy this file to .env and fill in values ─────────────
# cp .env.example .env

# ─── MQTT (Mosquitto) ─────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_TELEMETRY=engine/telemetry
MQTT_TOPIC_ALERTS=engine/alerts

# ─── TimescaleDB ──────────────────────────────────────────
POSTGRES_USER=digital_twin
POSTGRES_PASSWORD=changeme_hackathon
POSTGRES_DB=engine_db
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432

# ─── Backend (FastAPI ingestion) ──────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ─── ML Service (FastAPI inference) ───────────────────────
ML_HOST=0.0.0.0
ML_PORT=8001
ML_SERVICE_URL=http://ml:8001

# ─── Frontend (Vite) ──────────────────────────────────────
VITE_WS_URL=ws://localhost:8000/ws
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173

# ─── Simulator ────────────────────────────────────────────
# Options: normal | misfire | injector | lubrication | sensor_drift | combustion | overheating
SIM_FAULT_SCENARIO=normal
SIM_PUBLISH_INTERVAL=1.0
